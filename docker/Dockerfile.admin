FROM python:3.14.0-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir uvicorn fastapi redis pydantic

COPY src/ ./src/

# Non-root user for runtime security (DS-0002 compliance)
RUN adduser --disabled-password --gecos '' --uid 1000 management && \
    chown -R management:management /app
USER management

ENV PYTHONPATH=/app
EXPOSE 8090

CMD ["uvicorn", "src.management.app:app", "--host", "0.0.0.0", "--port", "8090"]

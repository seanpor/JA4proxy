FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir uvicorn fastapi redis pydantic

COPY src/ ./src/

ENV PYTHONPATH=/app
EXPOSE 8090

CMD ["uvicorn", "src.management.app:app", "--host", "0.0.0.0", "--port", "8090"]

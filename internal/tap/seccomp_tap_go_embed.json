        "sendto", "recvfrom", "sendmsg", "recvmsg", "sendmmsg", "recvmmsg",
        "setsockopt", "getsockopt", "shutdown", "getpeername", "getsockname",
        "read", "write", "readv", "writev", "pread64", "pwrite64",
        "open", "openat", "close", "stat", "fstat", "lstat", "lseek",
        "newfstatat", "statx",
        "mmap", "mprotect", "munmap", "madvise", "mincore", "msync",
        "brk", "mremap",
        "ioctl",
        "preadv", "pwritev", "preadv2", "pwritev2",
        "getpid", "getppid", "getuid", "getgid", "geteuid", "getegid",
        "getgroups", "getpgrp", "gettid",
        "getrlimit", "setrlimit", "prlimit64",
        "getrusage", "uname", "sysinfo", "times",
        "gettimeofday", "clock_gettime", "clock_getres", "clock_nanosleep",
        "rt_sigaction", "rt_sigprocmask", "rt_sigreturn", "sigaltstack",
        "kill", "tkill", "tgkill",
        "futex", "set_tid_address", "set_robust_list", "get_robust_list",

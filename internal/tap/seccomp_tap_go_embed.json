        "eventfd", "eventfd2", "pipe", "pipe2",
        "select",
        "dup", "dup2", "dup3",
        "fcntl", "flock", "fsync", "fdatasync",
        "access", "faccessat",
        "chdir", "fchdir", "getcwd",
        "readlink", "readlinkat",
        "truncate", "ftruncate",
        "exit", "exit_group",
        "prctl", "arch_prctl",
        "getrandom", "memfd_create",
        "clone", "rseq",
        "splice", "tee",
        "inotify_add_watch", "inotify_rm_watch", "inotify_init1",

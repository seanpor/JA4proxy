# Generated by ja4p init — phase-161
# Keys match the ja4pd config schema (internal/config): proxy.bind_host /
# bind_port / backend_host / backend_port — NOT a top-level server:/backend:.
proxy:
  bind_host: "0.0.0.0"          # public ingress (CAP_NET_BIND_SERVICE grants :443)
  bind_port: 443
  backend_host: "{{.BackendHost}}"
  backend_port: {{.BackendPort}}
{{- if .WritePROXY}}
  write_proxy_protocol: true
  write_proxy_protocol_version: {{.PROXYVersion}}
{{- end}}

logging:
  level: "{{.LogLevel}}"
  format: json

redis:
  # Native single-host runs Redis locally; container mode talks to the
  # compose "redis" service. A non-local host without a password is rejected
  # at startup (JA4PROXY-2026-0010), so native must point at loopback.
  host: "{{if eq .Mode "native"}}127.0.0.1{{else}}redis{{end}}"
  port: 6379
{{- if .AllowedSNIs}}
sni:
  allowed: [{{join .AllowedSNIs ","}}]
{{- end}}
{{- if .UpstreamLB}}
upstream_trust:
  enabled: true
  trusted_cidrs: [{{join .TrustedCIDRs ","}}]
{{- end}}

dial:
  value: {{.DialValue}}
  mode: {{if gt .DialValue 0}}active{{else}}monitor{{end}}
{{- if .GeoIPPaths}}
geoip:
  databases: [{{join .GeoIPPaths ","}}]
{{- end}}

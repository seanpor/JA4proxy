# Generated by ja4p init — phase-161
server:
  host: "{{.BindIP}}"
  port: 443
  topology: inline

logging:
  level: "{{.LogLevel}}"
  format: json

backend:
  host: "{{.BackendHost}}"
  port: {{.BackendPort}}
{{- if .WritePROXY}}
  write_proxy_protocol: true
  write_proxy_protocol_version: {{.PROXYVersion}}
{{- end}}
{{- if .AllowedSNIs}}
sni:
  allowed: [{{join .AllowedSNIs ","}}]
{{- end}}
{{- if .UpstreamLB}}
upstream_trust:
  enabled: true
  trusted_cidrs: [{{join .TrustedCIDRs ","}}]
{{- end}}

dial:
  value: {{.DialValue}}
  mode: {{if gt .DialValue 0}}active{{else}}monitor{{end}}
{{- if .GeoIPPaths}}
geoip:
  databases: [{{join .GeoIPPaths ","}}]
{{- end}}

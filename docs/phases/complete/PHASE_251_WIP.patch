diff --git a/.semgrep-phase251.yml b/.semgrep-phase251.yml
new file mode 100644
index 00000000..62c94d47
--- /dev/null
+++ b/.semgrep-phase251.yml
@@ -0,0 +1,57 @@
+rules:
+  - id: go-atomic-box-inner-no-nil-guard
+    languages: [go]
+    message: >
+      atomic.Pointer value is loaded (via .Load()) and the inner field is accessed
+      without a nil check on the box. If the box is nil this causes a nil-pointer
+      dereference panic. Pattern: box := p.thing.Load(); if box != nil { box.inner }
+    severity: ERROR
+    patterns:
+      - pattern: |
+          $BOX := $P.Load()
+          ...
+          $BOX.$INNER
+      - pattern-not: |
+          $BOX := $P.Load()
+          ...
+          if $BOX == nil { ... }
+          ...
+          $BOX.$INNER
+      - pattern-not: |
+          $BOX := $P.Load()
+          ...
+          if $BOX != nil { ... }
+          ...
+          $BOX.$INNER
+    metadata:
+      category: security
+      subcategory: [vulnerability]
+      confidence: HIGH
+      cwe: CWE-476
+      finding: Phase-251 C-1
+
+  - id: go-channel-range-goroutine-lifetime
+    languages: [go]
+    message: >
+      Goroutine uses `for ... := range $CHAN` without a select-on-stopCh
+      pattern. This goroutine can never be externally stopped (the channel is
+      never closed). Prefer `select { case <-stopCh: return; case job := <-$CHAN: ... }`.
+    severity: WARNING
+    patterns:
+      - pattern: |
+          func $FUNC(...) {
+            ...
+            go func() {
+              ...
+              for $JOB := range $CHAN {
+                ...
+              }
+            }()
+            ...
+          }
+    metadata:
+      category: security
+      subcategory: [audit]
+      confidence: MEDIUM
+      cwe: CWE-404
+      finding: Phase-251 M-1

# Security: Never commit secrets, keys, or credentials
deploy/secrets/*
!deploy/secrets/.gitkeep
!deploy/secrets/README.md

# Debug/scratch files
debug_asyncio_test.py
ci-test-output.txt

deploy/ssl/private/*
!deploy/ssl/private/.gitkeep
!deploy/ssl/private/README.md

deploy/ssl/certs/*.key
deploy/ssl/certs/*.pem

# Environment files with secrets (JA4PROXY-2026-0025)
# `.env.example` is the template that operators copy to `.env`; it holds
# placeholder values only and must stay tracked. The negation keeps it
# visible to git even though `.env.*` would otherwise ignore it.
.env
.env.*
!template.env
!.env.example

# Active agent tracker (written by: make agent-up NAME=<agent>)
# Contains only the agent name (e.g. "claude"). Never commit.
.current-agent
.env.local
.env.production

# Claude Code local settings (may contain API keys)
.claude/settings.local.json
# Claude Code agent worktrees (temporary isolation directories)
.claude/worktrees/

# Qwen Code merge artifacts (Git auto-generated, never useful)
.qwen/settings.json.orig

# Redis password files
*_password.txt
*_password

# Private keys
*.key
*.pem
*.p12
*.pfx

# Certificates (except CA certs for validation)
*.crt
*.cer
!ca.crt
!ca.cer

# Backup files that might contain secrets
*.bak
*.backup
*.old

# Database files
*.db
*.sqlite
*.sqlite3

# Logs that might contain sensitive data
logs/*
#*.log # dup
!logs/.gitkeep

# Server process files
server.pid
*.pid

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
!tests/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing
.pytest_cache/
.coverage*
coverage.json
coverage.xml
coverage.txt
htmlcov/
.tox/
.hypothesis/
reports/

# Planning artifacts
*.zip

# Docker
*.tar
*.gz

# OS
.DS_Store
Thumbs.db
!docs/reports/
node_modules/
package-lock.json
package.json

# Test result files
test_results_*.txt
connections-export-*.jsonl

# Local test results (timestamped logs + JUnit XML)
test-results/

# Machine-specific calibration (worker count, benchmark data)
.local/

# Build number (derived from git commit count — no file needed)
BUILD_NUMBER

# Go build artifacts
/bin/
/_build/
/ja4-tap
/ja4check
/ja4proxy
/ja4proxy-cli
/cmd/proxy/proxy
/proxy
# Stray root-level go builds (correct output is bin/ via the Makefile targets)
/ja4pd
/ja4p
/ja4p-setup


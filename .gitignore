# Security: Never commit secrets, keys, or credentials
secrets/*
!secrets/.gitkeep
!secrets/README.md

# Debug/scratch files
debug_asyncio_test.py

ssl/private/*
!ssl/private/.gitkeep
!ssl/private/README.md

ssl/certs/*.key
ssl/certs/*.pem

# Environment files with secrets
.env
.env.local
.env.production

# Claude Code local settings (may contain API keys)
.claude/settings.local.json
# Claude Code agent worktrees (temporary isolation directories)
.claude/worktrees/

# Redis password files
*_password.txt
*_password

# Private keys
*.key
*.pem
*.p12
*.pfx

# Certificates (except CA certs for validation)
*.crt
*.cer
!ca.crt
!ca.cer

# Backup files that might contain secrets
*.bak
*.backup
*.old

# Database files
*.db
*.sqlite
*.sqlite3

# Logs that might contain sensitive data
logs/*
*.log
!logs/.gitkeep

# Server process files
server.pid
*.pid

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
!tests/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/
reports/

# Planning artifacts
*.zip

# Docker
*.tar
*.gz

# OS
.DS_Store
Thumbs.db
!docs/reports/
node_modules/
package-lock.json
package.json

# Test result files
test_results_*.txt

# Local test results (timestamped logs + JUnit XML)
test-results/

# Machine-specific calibration (worker count, benchmark data)
.local/

# Go build artifacts
/bin/
/ja4check
/ja4proxy
/cmd/proxy/proxy
/proxy
/ja4proxy
/cmd/proxy/proxy

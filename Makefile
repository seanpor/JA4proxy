	@echo "=== helm lint: Helm charts ==="
	@if [ -d deploy/helm ]; then \
		docker run --rm -v $(PWD):/src alpine/helm:3.17.3 \
			lint /src/deploy/helm/ 2>&1 \
			|| echo "  ! helm lint reported issues (advisory)"; \
		echo "  ✓ helm lint done"; \
	else \
		true; \
	fi


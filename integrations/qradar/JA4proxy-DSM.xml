<?xml version="1.0" encoding="UTF-8"?>
<!--
  JA4proxy DSM (Device Support Module) for IBM QRadar SIEM

  Log Source Type:  JA4proxy TLS Security Proxy
  Log Format:       LEEF 2.0 over UDP syslog (port 514)

  Installation:
    1. Import this file via QRadar Admin → Data Sources → DSM Editor → Import
    2. Create a Log Source: Admin → Data Sources → Log Sources → Add
       - Log Source Type: JA4proxy TLS Security Proxy
       - Protocol: Syslog UDP, port 514
    3. Deploy the changes in QRadar

  See integrations/qradar/README.md for full installation instructions.

  Custom properties defined:
    ja4_fingerprint  - JA4 TLS client fingerprint
    ja4x_fingerprint - JA4X certificate fingerprint
    ja4t_fingerprint - JA4T TCP fingerprint
    risk_score       - JA4proxy composite risk score (0-100)
    dial_setting     - Proxy dial position (0-100)
    sni_hostname     - TLS SNI hostname
    asn_number       - Autonomous System Number
    asn_org          - ASN organisation name
    tls_resumed      - Whether TLS session was resumed (boolean)
-->
<DSMConfiguration DSMName="JA4proxy TLS Security Proxy"
                  DSMVersion="1.0.0"
                  RecordTypeId="2"
                  RequireDeployment="true"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!-- ── Log Source Identification ──────────────────────────────────────── -->
  <LogSourceType>JA4proxy TLS Security Proxy</LogSourceType>
  <LogSourceDescription>JA4proxy TLS-aware passthrough security proxy telemetry via LEEF 2.0</LogSourceDescription>
  <Vendor>JA4proxy</Vendor>
  <Version>1.0</Version>

  <!-- ── LEEF 2.0 Parser ────────────────────────────────────────────────── -->
  <RecordTypes>
    <RecordType id="1" name="JA4proxy Connection Event">
      <!-- LEEF 2.0 header: LEEF:2.0|JA4proxy|JA4proxy|{version}|{eventId}|0x09| -->
      <!-- Attributes are tab-separated key=value pairs after the header         -->

      <!-- QRadar built-in field mappings from LEEF attributes -->
      <FieldMappings>

        <!-- Source IP — maps to QRadar Source IP -->
        <FieldMapping field="src"     qradarfield="sourceip"        type="IP"     />

        <!-- Destination IP — maps to QRadar Destination IP -->
        <FieldMapping field="dst"     qradarfield="destinationip"   type="IP"     />

        <!-- Source Port -->
        <FieldMapping field="srcPort" qradarfield="sourceport"      type="Integer"/>

        <!-- Destination Port -->
        <FieldMapping field="dstPort" qradarfield="destinationport" type="Integer"/>

        <!-- Event category — the LEEF EventID field (action taken) -->
        <!-- Maps to QRadar Event Category via the QID map below -->
        <FieldMapping field="EventID"  qradarfield="eventcategory"   type="String" />

        <!-- Username — not applicable; mapped to empty for completeness -->
        <FieldMapping field="usrName" qradarfield="username"         type="String" />

        <!-- Device timestamp -->
        <FieldMapping field="devTime" qradarfield="devicetime"       type="String" />

        <!-- Device time format — LEEF 2.0 requirement -->
        <FieldMapping field="devTimeFormat" qradarfield="devtimeformat" type="String"/>

      </FieldMappings>

      <!-- QID (Event ID) mappings: LEEF EventID value → QRadar QID category -->
      <QIDMappings>
        <QIDMapping eventid="allowed"      QID="5001001" category="5001" name="Connection Allowed"      severity="3"/>
        <QIDMapping eventid="blocked"      QID="5001002" category="5001" name="Connection Blocked"      severity="7"/>
        <QIDMapping eventid="banned"       QID="5001003" category="5001" name="Source IP Banned"        severity="9"/>
        <QIDMapping eventid="tarpitted"    QID="5001004" category="5001" name="Connection Tarpitted"    severity="5"/>
        <QIDMapping eventid="rate_limited" QID="5001005" category="5001" name="Rate Limit Applied"      severity="5"/>
        <QIDMapping eventid="flagged"      QID="5001006" category="5001" name="Connection Flagged"      severity="4"/>
        <QIDMapping eventid="unknown"      QID="5001000" category="5001" name="Unknown Action"          severity="3"/>
      </QIDMappings>

    </RecordType>
  </RecordTypes>

  <!-- ── Custom Properties ──────────────────────────────────────────────── -->
  <!-- These extend the QRadar event schema with JA4proxy-specific fields.  -->
  <!-- After import, map these in: Admin → Data Sources → Custom Properties -->
  <CustomProperties>

    <CustomProperty name="ja4_fingerprint"
                    description="JA4 TLS client fingerprint. Identifies the client TLS implementation."
                    type="String"
                    leefField="ja4"
                    maxLength="128">
      <!-- Regex: t13d1516h2_aabbccddeeff_aabbccddeeff format -->
      <Expression>[to][0-9]{2}[di][0-9]{2}[a-z0-9]{2}_[a-f0-9]{12}_[a-f0-9]{12}</Expression>
    </CustomProperty>

    <CustomProperty name="ja4x_fingerprint"
                    description="JA4X TLS certificate fingerprint. Identifies server certificate attributes."
                    type="String"
                    leefField="ja4x"
                    maxLength="128">
    </CustomProperty>

    <CustomProperty name="ja4t_fingerprint"
                    description="JA4T TCP fingerprint. Identifies OS and TCP stack implementation."
                    type="String"
                    leefField="ja4t"
                    maxLength="64">
    </CustomProperty>

    <CustomProperty name="risk_score"
                    description="JA4proxy composite risk score, 0-100. Score >=70 triggers block at dial=100."
                    type="Numeric"
                    leefField="risk_score">
    </CustomProperty>

    <CustomProperty name="dial_setting"
                    description="JA4proxy blocking dial position, 0-100. 0=monitor only; 100=full blocking active."
                    type="Numeric"
                    leefField="dialSetting">
    </CustomProperty>

    <CustomProperty name="sni_hostname"
                    description="TLS Server Name Indication hostname from the ClientHello."
                    type="String"
                    leefField="sni"
                    maxLength="253">
    </CustomProperty>

    <CustomProperty name="asn_number"
                    description="Autonomous System Number of the source IP."
                    type="Numeric"
                    leefField="asn">
    </CustomProperty>

    <CustomProperty name="asn_org"
                    description="ASN organisation name from MaxMind GeoLite2-ASN."
                    type="String"
                    leefField="asnOrg"
                    maxLength="128">
    </CustomProperty>

    <CustomProperty name="tls_version"
                    description="Negotiated TLS protocol version (e.g. 1.2, 1.3)."
                    type="String"
                    leefField="sslVersion"
                    maxLength="8">
    </CustomProperty>

    <CustomProperty name="tls_cipher"
                    description="Negotiated TLS cipher suite (IANA name)."
                    type="String"
                    leefField="sslCipher"
                    maxLength="128">
    </CustomProperty>

    <CustomProperty name="country_code"
                    description="ISO 3166-1 alpha-2 country code of the source IP."
                    type="String"
                    leefField="country"
                    maxLength="2">
    </CustomProperty>

  </CustomProperties>

  <!-- ── Offense Contribution Rules ────────────────────────────────────── -->
  <!-- These contribute to QRadar offenses when risk thresholds are met.   -->
  <OffenseRules>

    <OffenseRule name="JA4proxy High Risk Connection"
                 description="Contribute to offense when JA4proxy risk_score >= 70 (block threshold)"
                 enabled="true"
                 offenseType="SOURCE_IP">
      <Condition>
        <CustomPropertyCondition property="risk_score" operator="GREATER_THAN_OR_EQUAL" value="70"/>
      </Condition>
      <Contribution magnitude="3"/>
    </OffenseRule>

    <OffenseRule name="JA4proxy Banned IP"
                 description="Contribute to offense when an IP is banned by JA4proxy (risk_score >= 85)"
                 enabled="true"
                 offenseType="SOURCE_IP">
      <Condition>
        <EventIDCondition eventid="banned"/>
      </Condition>
      <Contribution magnitude="5"/>
    </OffenseRule>

    <OffenseRule name="JA4proxy Repeated Blocks Same IP"
                 description="Escalate offense when same source IP is blocked 10+ times in 5 minutes"
                 enabled="true"
                 offenseType="SOURCE_IP">
      <Condition>
        <EventIDCondition eventid="blocked"/>
        <EventCountCondition count="10" timeWindowSeconds="300"/>
      </Condition>
      <Contribution magnitude="4"/>
    </OffenseRule>

  </OffenseRules>

</DSMConfiguration>

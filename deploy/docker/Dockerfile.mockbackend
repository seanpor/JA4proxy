# Dockerfile.mockbackend — High-performance Go-native null backend
FROM golang:1.26.5-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS builder

WORKDIR /build
COPY internal/test/nullbackend/main.go .
RUN go mod init nullbackend && go mod tidy
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /nullbackend main.go

FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
# Non-root user (JA4PROXY DS-0002: containers must not run as root). It binds a
# non-privileged port (8443) so it works under cap_drop=ALL in compose.
RUN apk upgrade --no-cache && apk add --no-cache ca-certificates curl && \
    adduser -D -H -s /sbin/nologin backend

WORKDIR /app
COPY --from=builder /nullbackend /usr/local/bin/nullbackend

# Mock-backend TLS cert (world-readable 644 so the non-root user can read it;
# test fixture only). nullbackend loads /app/backend.{crt,key}.
COPY deploy/ssl/certs/backend.crt /app/backend.crt
COPY deploy/ssl/private/backend.key /app/backend.key
RUN chmod 644 /app/backend.crt /app/backend.key

ENV PORT=8443
USER backend
EXPOSE 8443

# Health check (Go backend responds to health)
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -kf https://localhost:8443/api/health || exit 0

ENTRYPOINT ["/usr/local/bin/nullbackend"]

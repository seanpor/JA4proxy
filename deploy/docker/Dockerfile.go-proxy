# Dockerfile.go-proxy — multi-stage build for the JA4proxy Go binary.
#
# Build stage: full Go toolchain on Alpine.
# Runtime stage: minimal Alpine with only the binary + config.
# Target runtime image size: ≤ 10MB.
#
# Build:
#   docker build -f docker/Dockerfile.go-proxy -t ja4proxy-go .
#
# Run:
#   docker run --rm -p 8080:8080 \
#     -e REDIS_PASSWORD=secret \
#     -e BACKEND_HOST=your-backend \
#     ja4proxy-go

# ── Build stage ───────────────────────────────────────────────────────────────
FROM golang:1.26.5-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS builder
ARG VERSION=unknown
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

RUN apk add --no-cache ca-certificates git

WORKDIR /build

# Cache dependency downloads separately from source changes.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    go mod download

# Copy source and build a statically-linked binary.
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w -extldflags '-static' -X github.com/seanpor/ja4proxy/internal/config.Version=${VERSION} -X github.com/seanpor/ja4proxy/internal/config.GitCommit=${GIT_COMMIT} -X github.com/seanpor/ja4proxy/internal/config.BuildDate=${BUILD_DATE}" -trimpath -o /ja4pd ./cmd/ja4pd

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM alpine:3.19.3@sha256:95c16745f100f44cf9a0939fd3f357905f845f8b6fa7d0cde0e88c9764060185

# OCI image labels for registry discoverability and provenance.
LABEL org.opencontainers.image.source="https://github.com/seanpor/JA4proxy" \
      org.opencontainers.image.title="ja4proxy" \
      org.opencontainers.image.description="TLS-aware passthrough security proxy" \
      org.opencontainers.image.licenses="Apache-2.0"

# Non-root user for least-privilege operation.
# Explicit UID/GID 1000 required by Pod Security Admission `restricted` and
# the industry-standard `runAsUser: 1000` policy (see ADR-202c).
RUN apk upgrade --no-cache && apk add --no-cache curl && \
    addgroup -g 1000 -S ja4proxy && adduser -u 1000 -S -G ja4proxy ja4proxy

# CA certificates for TLS verification (backend connections).
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Binary
COPY --from=builder /ja4pd /usr/local/bin/ja4pd

# Config and Lua scripts (read at runtime; hot-reloadable via SIGHUP).
COPY config/proxy.yml /app/config/proxy.yml
COPY scripts/sliding_window.lua /app/scripts/sliding_window.lua

USER 1000:1000
WORKDIR /app

EXPOSE 8080 9090

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:9090/health || exit 1

ENTRYPOINT ["/usr/local/bin/ja4pd"]

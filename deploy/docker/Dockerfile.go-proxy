# Dockerfile.go-proxy — multi-stage build for the JA4proxy Go binary.
#
# Build stage: full Go toolchain on Alpine.
# Runtime stage: minimal Alpine with only the binary + config.
# Target runtime image size: ≤ 10MB.
#
# Build:
#   docker build -f docker/Dockerfile.go-proxy -t ja4proxy-go .
#
# Run:
#   docker run --rm -p 8080:8080 \
#     -e REDIS_PASSWORD=secret \
#     -e BACKEND_HOST=your-backend \
#     ja4proxy-go

# ── Build stage ───────────────────────────────────────────────────────────────
FROM golang:1.27.3-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS builder
ARG VERSION=unknown
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

RUN apk add --no-cache ca-certificates git

WORKDIR /build

# Cache dependency downloads separately from source changes.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    go mod download

# Copy source and build a statically-linked binary.
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w -buildid= -extldflags '-static' -X github.com/seanpor/ja4proxy/internal/config.Version=${VERSION} -X github.com/seanpor/ja4proxy/internal/config.GitCommit=${GIT_COMMIT} -X github.com/seanpor/ja4proxy/internal/config.BuildDate=${BUILD_DATE}" -trimpath -o /ja4pd ./cmd/ja4pd

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

# OCI image labels for registry discoverability and provenance.
LABEL org.opencontainers.image.source="https://github.com/seanpor/JA4proxy" \
      org.opencontainers.image.title="ja4proxy" \
      org.opencontainers.image.description="TLS-aware passthrough security proxy" \
      org.opencontainers.image.licenses="MIT AND LicenseRef-FoxIO-1.1"

# Environment variables for Go memory and GC management
ENV GOMEMLIMIT=400MiB \
    GOGC=100

# Non-root user for least-privilege operation.
# Explicit UID/GID 1000 required by Pod Security Admission `restricted` and
# the industry-standard `runAsUser: 1000` policy (see ADR-202c).
RUN apk upgrade --no-cache && \
    addgroup -g 1000 -S ja4proxy && adduser -u 1000 -S -G ja4proxy ja4proxy

# CA certificates for TLS verification (backend connections).
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Binary
COPY --from=builder /ja4pd /usr/local/bin/ja4pd

# License and attribution notices
COPY LICENSE NOTICE LICENSE.foxio /usr/share/doc/ja4proxy/

# Config and Lua scripts (read at runtime; hot-reloadable via SIGHUP).
COPY config/proxy.yml /app/config/proxy.yml
COPY scripts/sliding_window.lua /app/scripts/sliding_window.lua

USER 1000:1000
WORKDIR /app

EXPOSE 8080 9090

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD ["/usr/local/bin/ja4pd", "--health-check"]

ENTRYPOINT ["/usr/local/bin/ja4pd"]

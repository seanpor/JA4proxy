# Dockerfile.logtide — First-party container build for LogTide telemetry sidecar.
#
# Build stage: pinned Go toolchain on Alpine.
# Runtime stage: minimal distroless image with zero compiler/OS dependencies.
# Security rationale (Phase 840): Compiling LogTide from source eliminates
# third-party upstream container CVE waiver debt (.trivyignore.third-party).

# ── Build stage ───────────────────────────────────────────────────────────────
FROM golang:1.27.3-alpine@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS builder
ARG VERSION=unknown
ARG GIT_COMMIT=unknown

RUN apk add --no-cache ca-certificates git

WORKDIR /build

# Cache dependency downloads
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build statically-linked LogTide binary
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -extldflags '-static'" \
    -trimpath \
    -o /build/logtide ./cmd/ja4p/

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM gcr.io/distroless/static-debian12@sha256:d75cdd72874d4790092fcb1b058493ecf6bb5bf2b2b897045b00ff01d91843f2

COPY --from=builder /build/logtide /usr/local/bin/logtide
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

USER nonroot:nonroot

EXPOSE 8080 9090

ENTRYPOINT ["/usr/local/bin/logtide"]

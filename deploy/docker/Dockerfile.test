FROM python:3.14.0-slim@sha256:0aecac02dc3d4c5dbb024b753af084cafe41f5416e02193f1ce345d671ec966e

# Security: Create non-root user - may already exist in base image
RUN groupadd -r proxy 2>/dev/null || true
RUN useradd -r -g proxy proxy 2>/dev/null || true

# Install system dependencies
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y && apt-get install -y --no-install-recommends \
    gcc \
    libpcap-dev \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Upgrade pip and install packaging to resolve dependency conflicts
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install --upgrade pip setuptools wheel packaging

# Copy and install Python dependencies
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install -r requirements.txt

# Copy test dependencies
COPY requirements-test.txt .
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install -r requirements-test.txt

# Copy application and test files
COPY tests/ tests/
COPY config/ config/
COPY security/ security/
COPY src/ src/
COPY scripts/ scripts/

# Add /app to PYTHONPATH so src module can be imported
ENV PYTHONPATH=/app:$PYTHONPATH

# Prevent Python output buffering in Docker
ENV PYTHONUNBUFFERED=1

# Create test reports directory
RUN mkdir -p reports && chown -R proxy:proxy /app

# Switch to non-root user
USER proxy

# Health check for test container
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import sys; sys.exit(0)"

# Use custom entrypoint
ENTRYPOINT ["/app/scripts/docker-entrypoint.sh"]
CMD ["pytest", "tests/", "-v", "--cov=proxy", "--cov-report=html:reports/coverage", "--cov-report=term", "--junitxml=reports/junit.xml"]

# Phase 317: alpine base + de-reference the archived Python prototype.
# The Debian python:3.14-slim image carried many no-fix HIGH/CRITICAL distro CVEs
# (curl, ncurses, perl, libssh2, linux-libc-dev) that blocked the first-party HIGH
# gate. The full test/dev dep stack (cryptography, aiohttp, uvloop, pyyaml,
# pytricia, scapy, semgrep, ...) was verified to build on py3.14-alpine/musl;
# `apk upgrade` on alpine 3.24 clears musl-utils/zlib. The root `proxy.py` Python
# prototype was archived in Phase 128 (5afeba2), so it is no longer copied and the
# coverage target is the surviving `src/` package.
FROM python:3.14.7-alpine3.24@sha256:3f818d6811ff5f3f2b5e5d836df3d25c2dd2e588d3b4981338a8ba17e422f74f

# Patch base OS packages to clear any pending CVEs.
RUN apk upgrade --no-cache

# Security: create non-root user (alpine: addgroup/adduser).
RUN addgroup -S proxy 2>/dev/null || true && \
    adduser -S -G proxy proxy 2>/dev/null || true

# Build + runtime system dependencies. libpcap-dev provides scapy's runtime lib;
# the toolchain compiles any wheels lacking a musllinux build. (CI-only image.)
RUN --mount=type=cache,target=/var/cache/apk,sharing=locked \
    apk add --no-cache \
    build-base \
    libpcap-dev \
    openssl-dev \
    python3-dev \
    linux-headers \
    libffi-dev \
    cargo \
    curl

# Set working directory
WORKDIR /app

# Upgrade pip and install packaging to resolve dependency conflicts
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install --upgrade pip setuptools wheel packaging

# Copy and install Python dependencies
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install -r requirements.txt

# Copy test dependencies
COPY requirements-test.txt .
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install -r requirements-test.txt

# Copy application and test files (proxy.py was archived in Phase 128)
COPY tests/ tests/
COPY config/ config/
COPY src/ src/
COPY scripts/ scripts/

# Add /app to PYTHONPATH so src module can be imported
ENV PYTHONPATH=/app:$PYTHONPATH

# Prevent Python output buffering in Docker
ENV PYTHONUNBUFFERED=1

# Create test reports directory
RUN mkdir -p reports && chown -R proxy:proxy /app

# Switch to non-root user
USER proxy

# Health check for test container
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import sys; sys.exit(0)"

# Use custom entrypoint
ENTRYPOINT ["/app/scripts/docker-entrypoint.sh"]
CMD ["pytest", "tests/", "-v", "--cov=src", "--cov-report=html:reports/coverage", "--cov-report=term", "--junitxml=reports/junit.xml"]

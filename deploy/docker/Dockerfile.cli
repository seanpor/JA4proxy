# Dockerfile-cli — multi-stage build for the ja4proxy-cli management binary.
#
# Build stage: full Go toolchain on Alpine.
# Runtime stage: minimal distroless image with only the binary.
# Target runtime image size: ≤ 15MB.
#
# Build:
#   docker build -f Dockerfile-cli -t ghcr.io/seanpor/ja4proxy-cli:latest .
#
# Run:
#   docker run --rm ghcr.io/seanpor/ja4proxy-cli:latest \
#     --url https://mgmt.example.com --token $TOKEN ip ban 198.51.100.1

# ── Build stage ───────────────────────────────────────────────────────────────
FROM golang:1.26.6-alpine@sha256:af8d6740070b8906d12eae1c3e3ea0957fb63f492051ea05e354c38ef9fe88df AS builder
ARG VERSION=unknown
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

RUN apk add --no-cache ca-certificates git

WORKDIR /build

# Cache dependency downloads separately from source changes.
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build a statically-linked binary.
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w -extldflags '-static' -X github.com/seanpor/ja4proxy/internal/config.Version=${VERSION} -X github.com/seanpor/ja4proxy/internal/config.GitCommit=${GIT_COMMIT} -X github.com/seanpor/ja4proxy/internal/config.BuildDate=${BUILD_DATE}" -trimpath -o /build/ja4p ./cmd/ja4p/

# ── Runtime stage ─────────────────────────────────────────────────────────────
# checkov:skip=CKV_DOCKER_2: CLI tool is short-lived and doesn't run a service
FROM gcr.io/distroless/static-debian12@sha256:d75cdd72874d4790092fcb1b058493ecf6bb5bf2b2b897045b00ff01d91843f2

COPY --from=builder /build/ja4p /usr/local/bin/ja4p
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Explicit USER for Trivy DS-0002 compliance (distroless:nonroot already sets
# UID 65532, but Trivy's static scan cannot detect the base image user).
USER nonroot

# Config directory for ~/.config/ja4proxy/cli.yaml when running interactively.
# In container use, pass --url and --token flags or environment variables.
ENV HOME=/home/nonroot

ENTRYPOINT ["/usr/local/bin/ja4p"]

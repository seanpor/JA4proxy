FROM python:3.14.0-slim

WORKDIR /app

# Install deps first for layer caching
COPY management/requirements.txt .
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && apt-get install -y --no-install-recommends \
        curl libyaml-dev && \
    pip install --upgrade pip setuptools wheel Cython && \
    PYAML_FORCE_PURE=true pip install -r requirements.txt && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy management service
COPY management/ ./management/

# Non-root user
RUN useradd -r -u 1001 -s /bin/false management
USER management

EXPOSE 8090

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8090/health || exit 1

CMD ["uvicorn", "management.api.main:app", "--host", "0.0.0.0", "--port", "8090", "--workers", "1"]

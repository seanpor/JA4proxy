# Dockerfile.go-proxy.foss — Pure FOSS / royalty-free build of JA4proxy Go binary.
# Compiled with -tags no_ja4plus, removing all FoxIO License 1.1 / patent-pending JA4+ methods.
# Licensed under MIT and BSD-3-Clause only.

# ── Build stage ───────────────────────────────────────────────────────────────
FROM golang:1.27.3-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS builder
ARG VERSION=unknown
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

RUN apk add --no-cache ca-certificates git gcc musl-dev

WORKDIR /build

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    go mod download

COPY . .
# Keep in sync: F2 hardened flags — see docs/phases/PHASE_863.md flag matrix
RUN ./scripts/go_build_hardened.sh /ja4pd ./cmd/ja4pd no_ja4plus

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

LABEL org.opencontainers.image.source="https://github.com/seanpor/JA4proxy" \
      org.opencontainers.image.title="ja4proxy-foss" \
      org.opencontainers.image.description="TLS-aware passthrough security proxy (Pure FOSS Edition)" \
      org.opencontainers.image.licenses="MIT AND BSD-3-Clause"

RUN apk upgrade --no-cache && apk add --no-cache curl && \
    addgroup -g 1000 -S ja4proxy && adduser -u 1000 -S -G ja4proxy ja4proxy

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /ja4pd /usr/local/bin/ja4pd

COPY LICENSE NOTICE /usr/share/doc/ja4proxy/

COPY config/proxy.yml /app/config/proxy.yml
COPY internal/security/rules/ /app/internal/security/rules/

RUN mkdir -p /app/certs /app/logs /app/data && \
    chown -R ja4proxy:ja4proxy /app

USER 1000:1000
WORKDIR /app

EXPOSE 8443 9090

HEALTHCHECK --interval=5s --timeout=2s --start-period=3s --retries=3 \
    CMD curl -f http://localhost:9090/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/ja4pd"]
CMD ["-config", "/app/config/proxy.yml"]

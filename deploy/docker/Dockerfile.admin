FROM python:3.14.0-slim@sha256:0aecac02dc3d4c5dbb024b753af084cafe41f5416e02193f1ce345d671ec966e

WORKDIR /app

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install -r requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install uvicorn fastapi redis pydantic

COPY src/ ./src/

# Non-root user for runtime security (DS-0002 compliance)
RUN adduser --disabled-password --gecos '' --uid 1000 management && \
    chown -R management:management /app
USER management

ENV PYTHONPATH=/app
EXPOSE 8090

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8090/api/v1/health || exit 1

CMD ["uvicorn", "src.management.app:app", "--host", "0.0.0.0", "--port", "8090"]

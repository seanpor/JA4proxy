# Phase 317: alpine base — the Debian python:3.15-slim image carried no-fix HIGH/
# CRITICAL distro CVEs (curl, ncurses, perl, linux-libc-dev) that blocked the
# first-party HIGH gate. This image needs only the Python standard library, so
# there is no musl-wheel risk in the move.
FROM python:3.15.2-alpine3.24@sha256:20a82dbc2783112ddb91d1534603f802d222a3e63e593cd002eb2ac534e70211

# Patch base-image OS packages to clear any pending CVEs (alpine: apk).
# Strip default pip/ensurepip from base image so unused packaging tools and
# their vendored dependencies are not present in the runtime image.
RUN apk upgrade --no-cache && \
    rm -rf /usr/local/lib/python3.*/ensurepip \
           /usr/local/lib/python3.*/site-packages/pip* \
           /usr/local/lib/python3.*/site-packages/setuptools* \
           /usr/local/lib/python3.*/site-packages/wheel* \
           /usr/local/bin/pip* && \
    ! python3 -m pip --version 2>/dev/null

# checkov:skip=CKV_DOCKER_2: Traffic generator is short-lived and doesn't run a service
# Security: Create non-root user (alpine: addgroup/adduser)
RUN addgroup -S trafficgen && adduser -S -G trafficgen trafficgen

WORKDIR /app

# Only need the standard library (ssl, socket, argparse, etc.)
# No pip install required

COPY scripts/tls-traffic-generator.py /app/tls-traffic-generator.py
COPY scripts/benchmark.py /app/scripts/benchmark.py

RUN chown -R trafficgen:trafficgen /app
USER trafficgen

ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "/app/tls-traffic-generator.py"]
CMD ["--target-host", "proxy", "--target-port", "8080", "--duration", "60", "--good-percent", "15", "--workers", "15"]

// config.alloy — Grafana Alloy log pipeline (phase-825)
//
// Translated from deploy/monitoring/loki/promtail-config.yml. Promtail is EOL
// upstream; Alloy is its supported successor and scans 6 HIGH/CRITICAL against
// promtail's 29.
//
// This is River, not YAML. The translation preserves the promtail behaviour
// exactly, because a silent difference here stops log delivery and an EMPTY
// LOKI LOOKS IDENTICAL TO A QUIET SYSTEM — nothing alerts on it. The arrival
// test in tests/integration/infra-monitoring/check_alloy_log_delivery.sh is
// what proves this file works; "the container is Up" proves nothing.
//
// Label contract preserved from promtail (dashboards and saved queries use it):
//   container  — full container name, leading "/" stripped
//   service    — the part after "ja4proxy-", or literally "proxy" for the
//                bare "ja4proxy" container
//   level      — parsed from the structured log line
//   action     — ALLOWED|BLOCKED|WHITELISTED|BLACKLISTED|TIMEOUT, proxy only

// ── Discovery ────────────────────────────────────────────────────────────────
// JA4PROXY-2026-0017 — discovery goes via docker-socket-proxy, which whitelists
// only the CONTAINERS endpoint. Alloy has no direct access to the Docker socket,
// exactly as promtail did not.
discovery.docker "ja4proxy" {
	host             = "tcp://docker-socket-proxy:2375"
	refresh_interval = "5s"

	// Docker's `name` filter is a SUBSTRING match, so this single value matches
	// every ja4proxy container and keeps matching once names are lane-prefixed
	// (ja4proxy-lane23-backend-1, ...). See the phase-800 note in the promtail
	// config for why the per-service values that used to be here were dead.
	filter {
		name   = "name"
		values = ["ja4proxy"]
	}
}

// ── Relabel ──────────────────────────────────────────────────────────────────
discovery.relabel "ja4proxy" {
	targets = discovery.docker.ja4proxy.targets

	// Container name as the primary label.
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	// Service role from the container name.
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/ja4proxy-(.*)"
		target_label  = "service"
	}

	// The main proxy container is just "ja4proxy".
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/ja4proxy$"
		target_label  = "service"
		replacement   = "proxy"
	}
}

// ── Source ───────────────────────────────────────────────────────────────────
loki.source.docker "ja4proxy" {
	host       = "tcp://docker-socket-proxy:2375"
	targets    = discovery.relabel.ja4proxy.output
	forward_to = [loki.process.ja4proxy.receiver]
}

// ── Pipeline ─────────────────────────────────────────────────────────────────
loki.process "ja4proxy" {
	// Parse the proxy's structured log lines.
	stage.regex {
		expression = `(?P<timestamp>\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2},\d{3}) - (?P<logger>\S+) - (?P<level>\w+) - (?P<message>.*)`
	}

	stage.labels {
		values = {
			level = "",
		}
	}

	// Tag security events on the proxy only.
	stage.match {
		selector = "{service=\"proxy\"}"

		stage.regex {
			expression = "(?P<action>ALLOWED|BLOCKED|WHITELISTED|BLACKLISTED|TIMEOUT):"
		}

		stage.labels {
			values = {
				action = "",
			}
		}
	}

	forward_to = [loki.write.default.receiver]
}

// ── Write ────────────────────────────────────────────────────────────────────
loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

// ── Container metrics (phase-829c) ───────────────────────────────────────────
// Replaces the standalone gcr.io/cadvisor/cadvisor:v0.52.1 sidecar.
//
// WHY: that image carries 49 HIGH/CRITICAL findings and is the EXCLUSIVE
// carrier of 24 .trivyignore entries — measured 2026-08-19, it is the only
// change that shrinks that file (56 entries -> 21). Upgrading does not help:
// v0.55.1 is the newest published tag and is a net regression (clears
// CVE-2024-41110, introduces CVE-2026-31789, both CRITICAL).
//
// This binary ALREADY CONTAINS cadvisor — github.com/google/cadvisor is linked
// in and `prometheus.exporter.cadvisor` is a first-class component. The stack
// was running cadvisor's code twice: once here, inside an image we deploy,
// scan and scrape anyway, and once as a separate image nobody could rebuild.
//
// SECURITY NOTE, deliberately recorded. JA4PROXY-2026-0017 removed Alloy's
// Docker socket, and JA4PROXY-2026-0016 cut cadvisor back from
// `privileged: true` to SYS_PTRACE + DAC_READ_SEARCH. Folding the two together
// gives the log shipper cadvisor's host visibility. That is a real
// concentration of privilege, accepted knowingly in exchange for removing an
// unrebuildable image with 49 findings — NOT an oversight. The compose file
// grants only the capabilities and read-only mounts cadvisor itself had, and
// tests/unit/test_monitoring_privileges.py asserts the Docker socket does not
// come back.
prometheus.exporter.cadvisor "containers" {
	// Match the sidecar's collection surface. docker_only keeps this to
	// container cgroups rather than every cgroup on the host, which is what the
	// scrape job's `name=""` relabel drop was doing by hand.
	docker_only = true

	// The sidecar's metric_relabel_configs dropped these as high-cardinality and
	// unused; disabling them at the source is cheaper than dropping them after
	// transfer.
	disabled_metrics = ["referenced_memory", "cpu_topology", "resctrl"]

	// MEASURED 2026-08-19 during the parallel-run parity check: left at its
	// default this exporter attaches ~28 `container_label_*` dimensions to
	// EVERY series — every Docker Compose label, every OCI image annotation.
	// Nothing in alerts.yml, recording_rules.yml or the dashboards references a
	// single one of them (grep: zero hits); the rules select on `name` only.
	//
	// Carrying them would multiply Prometheus' series cardinality for data no
	// query reads. `name`, `id` and `image` are core cadvisor labels and are
	// unaffected by this setting.
	store_container_labels = false

	storage_duration = "5m"
}

// Prometheus SCRAPES this component's endpoint — it is not pushed. That keeps
// the existing pull architecture (Prometheus has no remote-write receiver
// enabled) and keeps the `cadvisor` job label, so every recording rule, alert
// and dashboard panel resolves unchanged. Phase-820 changed a label during an
// equivalent swap (haproxy-exporter `frontend=` -> native `proxy=`) and had to
// migrate every selector; not repeating that if it can be avoided.
//
// Endpoint: /api/v0/component/prometheus.exporter.cadvisor.containers/metrics
// on the Alloy HTTP server (:12345). See prometheus.yml's `cadvisor` job.

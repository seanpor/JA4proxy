{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "id": null,
  "uid": "ja4proxy-tap-sensor",
  "title": "JA4 Proxy - TAP Sensor",
  "tags": ["ja4", "tap", "passive", "capture"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "panels": [
    {
      "id": 1,
      "title": "Capture",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Packets / s",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "pps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
          "expr": "rate(ja4proxy_tap_packets_received_total[1m])",
          "legendFormat": "received"
        }
      ]
    },
    {
      "id": 3,
      "title": "Drop Rate / s",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 1},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "pps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
          "expr": "rate(ja4proxy_tap_packets_dropped_total[1m])",
          "legendFormat": "dropped ({{ reason }})"
        }
      ]
    },
    {
      "id": 4,
      "title": "Ring Buffer Fill Ratio",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 1},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.7},
              {"color": "orange", "value": 0.85},
              {"color": "red", "value": 0.9}
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
          "expr": "ja4proxy_tap_ring_buffer_fill_ratio",
          "legendFormat": "fill ratio",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Reassembly",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9}
    },
    {
      "id": 6,
      "title": "Active Streams",
      "description": "PHASE_803 O-003: was ja4proxy_tap_streams_active (wrong word order); the real gauge is ja4proxy_tap_active_streams.",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 500000},
              {"color": "orange", "value": 800000},
              {"color": "red", "value": 900000}
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
          "expr": "ja4proxy_tap_active_streams",
          "legendFormat": "Active streams",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Worker Restarts / 5m",
      "description": "PHASE_803 O-003: new panel. ja4proxy_tap_worker_restarts_total already existed and backs the TapWorkerCrashLoop alert, but was never visualised anywhere on this dashboard.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
          "expr": "increase(ja4proxy_tap_worker_restarts_total[5m])",
          "legendFormat": "watchdog restarts"
        }
      ]
    },
    {
      "id": 8,
      "title": "Fingerprinting",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18}
    },
    {
      "id": 9,
      "title": "Handshakes Extracted / s — by Kind",
      "description": "PHASE_803 O-003: was rate(ja4proxy_tap_fingerprints_extracted_total[1m]) with legend {{ type }} -- that metric never existed. Remapped to the real ja4proxy_tap_handshakes_extracted_total{kind}; panel renamed to match the metric's own name/Help text.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 19},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
          "expr": "rate(ja4proxy_tap_handshakes_extracted_total[1m])",
          "legendFormat": "{{ kind }}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Enforcement & Redis Health",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 27}
    },
    {
      "id": 11,
      "title": "Enforcement Actions / s",
      "description": "PHASE_803 O-003: was rate(ja4proxy_tap_pipeline_actions_total[1m]) with legend {{ action }} -- this sensor has no 'pipeline scoring' concept (that belongs to the inline proxy's risk scorer, a different binary). Remapped to the real ja4proxy_tap_enforcement_actions_total{result} (skipped|watchlist|banned|error); panel and row renamed to match.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
          "expr": "rate(ja4proxy_tap_enforcement_actions_total[1m])",
          "legendFormat": "{{ result }}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Redis Circuit Breaker",
      "description": "PHASE_803 R-002: new panel for the circuit breaker this phase added (internal/tap/circuit_breaker.go). A healthy deployment stays flat at 0 on both series.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
          "expr": "increase(ja4proxy_tap_redis_circuit_breaker_opened_total[5m])",
          "legendFormat": "opened"
        },
        {
          "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
          "expr": "rate(ja4proxy_tap_redis_circuit_breaker_skips_total[1m])",
          "legendFormat": "writes skipped/s"
        }
      ]
    }
  ]
}

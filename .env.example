# ============================================================
# JA4proxy — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   chmod 600 .env
#
# NEVER commit .env to version control — it contains secrets.
#
# For the POC, just run ./start-poc.sh — it auto-generates
# REDIS_PASSWORD and GRAFANA_PASSWORD with secure random values.
# ============================================================


# ============================================================
# BACKEND — where JA4proxy forwards clean traffic
# ============================================================
# Set this to the real server that sits behind JA4proxy.
# In the POC, the mock backend container is used automatically.
# For production, change this to your actual server address.
#
# Examples:
#   BACKEND_HOST=192.168.1.100   # On-premise server by IP
#   BACKEND_HOST=10.0.0.50       # Internal network server
#   BACKEND_HOST=myserver.local  # DNS name
#   BACKEND_HOST=backend         # Docker service name (POC default)
#
BACKEND_HOST=backend
BACKEND_PORT=443


# ============================================================
# SECRETS — auto-generated by start-poc.sh if not set
# ============================================================
# Generate manually with:  openssl rand -base64 32
#
REDIS_PASSWORD=changeme
GRAFANA_PASSWORD=admin


# ============================================================
# ENVIRONMENT
# ============================================================
# Options: development | staging | production
# In production mode, the proxy enforces stricter Redis auth checks.
#
ENVIRONMENT=development


# ============================================================
# PORT OVERRIDES (optional — defaults shown)
# ============================================================
# Uncomment and change if the default ports conflict with
# other services on your host.
#
# HAPROXY_TLS_PORT=443         # TLS entry point (client-facing)
# HAPROXY_HTTP_PORT=8880       # HTTP redirect port
# HAPROXY_STATS_PORT=8404      # HAProxy stats page
# PROXY_METRICS_PORT=9090      # Prometheus scrape endpoint
# PROMETHEUS_PORT=9091         # Prometheus UI
# GRAFANA_PORT=3001            # Grafana dashboard


# ============================================================
# THREAT INTELLIGENCE (optional)
# ============================================================
# ja4db.com API key — for broader fingerprint lookups beyond
# the free FoxIO GitHub CSV feed. Get a key at https://ja4db.com/
#
# JA4DB_API_KEY=your_key_here


# ============================================================
# LOGGING
# ============================================================
# LOG_LEVEL=INFO   # Options: DEBUG, INFO, WARNING, ERROR


# ============================================================
# PRODUCTION CHECKLIST
# ============================================================
# 1. Set BACKEND_HOST / BACKEND_PORT to your real server
# 2. Set strong REDIS_PASSWORD  (min 32 chars, openssl rand -base64 32)
# 3. Set strong GRAFANA_PASSWORD
# 4. Set ENVIRONMENT=production
# 5. chmod 600 .env
# 6. Restrict access: only the JA4proxy host should reach Redis
# 7. Rotate credentials every 90 days

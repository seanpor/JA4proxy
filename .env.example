# JA4proxy Environment Configuration
# Copy this file to .env and fill in your values.

# Redis
REDIS_PASSWORD=change_me_redis_strong_password

# Management Console
MANAGEMENT_JWT_SECRET=change_me_jwt_secret
MANAGEMENT_ADMIN_USER=admin
MANAGEMENT_ADMIN_PASSWORD=change_me_admin_password

# HAProxy Stats
HAPROXY_STATS_USER=stats
HAPROXY_STATS_PASSWORD=change_me_stats_password

# Grafana
GRAFANA_PASSWORD=change_me_grafana_password

# Redis credentials for analytics container (Phase 236 ACL)
ANALYTICS_REDIS_PASSWORD=change_me_analytics_strong_password
MANAGEMENT_REDIS_PASSWORD=change_me_management_strong_password

# Environment
ENVIRONMENT=development

# ============================================================
# JA4proxy — Environment Configuration
# ============================================================

# ── 1. PROJECT ISOLATION ────────────────────────────────────
# COMPOSE_PROJECT_NAME prefixes all Docker containers, networks,
# and volumes. Change this to run multiple JA4proxy instances
# on the same host (e.g., ja4proxy-dev, ja4proxy-prod).
COMPOSE_PROJECT_NAME=ja4proxy

# ── 2. BACKEND ──────────────────────────────────────────────
# Set this to the real server that sits behind JA4proxy.
BACKEND_HOST=backend
BACKEND_PORT=443

# ── 3. SECRETS (Autogenerated by ja4p init) ─────────────────
REDIS_PASSWORD=changeme
GRAFANA_PASSWORD=admin
REDIS_SIGNING_KEY=changeme
MANAGEMENT_JWT_SECRET=changeme
MANAGEMENT_ADMIN_USER=admin
MANAGEMENT_ADMIN_PASSWORD=changeme

# ── 4. ENVIRONMENT ──────────────────────────────────────────
# development | staging | production
ENVIRONMENT=development

# ── 5. PORT OVERRIDES ───────────────────────────────────────
# Change these if you have port conflicts on your host.
HOST_PORT_INGRESS=443
HOST_PORT_STATS=8404
HOST_PORT_METRICS=9090
HOST_PORT_PROMETHEUS=9091
HOST_PORT_GRAFANA=3000
HOST_PORT_ANALYTICS=8085
HOST_PORT_ADMIN_API=8091
HOST_PORT_MANAGEMENT=8090

# ── 6. OBSERVABILITY (Optional) ─────────────────────────────
METRICS_BIND_HOST=127.0.0.1
METRICS_AUTH_TOKEN=
LOG_LEVEL=INFO

# ── 7. THREAT INTELLIGENCE (Optional) ───────────────────────
# JA4DB_API_KEY=
# ABUSEIPDB_API_KEY=

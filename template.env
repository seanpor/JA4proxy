# ==============================================================================
# JA4proxy v2.0 — Environment Template
# ==============================================================================
# This file serves as the blueprint for your .env file.
# Run 'make init' to generate a secure, project-specific .env automatically.

# ── 1. PROJECT IDENTITY ───────────────────────────────────────────────────────
# Unique name for this instance (prefixes Docker resources).
COMPOSE_PROJECT_NAME=ja4proxy

# ── 2. UPSTREAM BACKEND ───────────────────────────────────────────────────────
# The real server protected by JA4proxy.
BACKEND_HOST=backend
BACKEND_PORT=443

# ── 3. OPERATIONAL MODES ──────────────────────────────────────────────────────
# development | staging | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── 4. PERFORMANCE TUNING ─────────────────────────────────────────────────────
# Buffer size for TCP copies (default: 16384).
JA4PROXY_BUFFER_SIZE=32768
# Max concurrent connections before rejection.
JA4PROXY_MAX_CONNS=10000

# ── 5. NETWORK BINDINGS ───────────────────────────────────────────────────────
# Offset added to all host ports (e.g. 1000 moves 8081 -> 9081).
HOST_PORT_OFFSET=0

# Default Ingress Ports
HOST_PORT_INGRESS=443
HOST_PORT_DIRECT=8081

# Management & Analytics
HOST_PORT_MANAGEMENT=8090
HOST_PORT_ADMIN_API=8091
HOST_PORT_ANALYTICS=8085

# Monitoring (Prometheus/Grafana)
HOST_PORT_STATS=8404
HOST_PORT_METRICS=9090
HOST_PORT_PROMETHEUS=9091
HOST_PORT_GRAFANA=3000

# ── 6. SECURITY SECRETS (Placeholders — generated by init) ────────────────────
REDIS_PASSWORD=REPLACE_ME_SECURELY
REDIS_SIGNING_KEY=REPLACE_ME_SECURELY
MANAGEMENT_JWT_SECRET=REPLACE_ME_SECURELY
MANAGEMENT_ADMIN_USER=admin
MANAGEMENT_ADMIN_PASSWORD=REPLACE_ME_SECURELY
GRAFANA_PASSWORD=admin

FROM python:3.14-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpcap-dev gcc \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt 2>/dev/null || \
    pip install --no-cache-dir scapy redis prometheus-client pyyaml aiohttp
COPY proxy.py ./
COPY config/ ./config/
COPY src/ ./src/
COPY scripts/sliding_window.lua ./scripts/
EXPOSE 8080 9090
ENV PYTHONPATH=/app
CMD ["python3", "proxy.py"]

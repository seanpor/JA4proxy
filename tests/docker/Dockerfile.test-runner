FROM golang:1.26-alpine@sha256:f23e8b227fb4493eabe03bede4d5a32d04092da71962f1fb79b5f7d1e6c2a17f AS go-builder
WORKDIR /app
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    go mod download
COPY . .
RUN go build -o /ja4check ./cmd/ja4check
RUN go build -o /ja4proxy ./cmd/proxy

FROM python:3.14.0-slim
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && apt-get install -y --no-install-recommends \
    curl openssl redis-tools netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*
RUN useradd -r -u 1001 -s /bin/false testrunner
WORKDIR /app
COPY requirements*.txt ./
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install pytest pytest-asyncio requests redis 2>/dev/null || \
    pip install pytest requests redis
COPY . .
COPY --from=go-builder /ja4check /usr/local/bin/ja4check
COPY --from=go-builder /ja4proxy /usr/local/bin/ja4proxy
RUN mkdir -p bin && ln -sf /usr/local/bin/ja4proxy bin/ja4proxy && \
    chown -R testrunner:testrunner /app
ENV PYTHONPATH=/app
HEALTHCHECK NONE
USER testrunner
CMD ["python3", "-m", "pytest", \
     "tests/integration/test_go_python_parity.py", \
     "tests/chaos/test_go_proxy_chaos.py", \
     "tests/performance/test_bench_go_proxy.py", \
     "-v", "--tb=short"]

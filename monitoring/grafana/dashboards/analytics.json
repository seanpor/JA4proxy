{
  "id": null,
  "uid": "ja4proxy-analytics",
  "title": "JA4 Proxy - Analytics & Score Health",
  "tags": ["ja4", "analytics", "score-health", "drift"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m"]
  },
  "panels": [
    {
      "id": 1,
      "title": "Score Drift Detected",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          },
          "mappings": [
            {"options": {"0": {"text": "OK"}}, "type": "value"},
            {"options": {"1": {"text": "DRIFT"}}, "type": "value"}
          ],
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
          "expr": "ja4proxy_analytics_score_drift_detected",
          "legendFormat": "Drift",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Calibration Issue",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 1}
            ]
          },
          "mappings": [
            {"options": {"0": {"text": "OK"}}, "type": "value"},
            {"options": {"1": {"text": "ISSUE"}}, "type": "value"}
          ],
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
          "expr": "ja4proxy_analytics_calibration_issue",
          "legendFormat": "Calibration",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Distribution Shift",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 1}
            ]
          },
          "mappings": [
            {"options": {"0": {"text": "Normal"}}, "type": "value"},
            {"options": {"1": {"text": "SHIFTED"}}, "type": "value"}
          ],
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
          "expr": "ja4proxy_analytics_distribution_shift",
          "legendFormat": "Distribution",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Current Score Median",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 20},
              {"color": "orange", "value": 40},
              {"color": "red", "value": 60}
            ]
          },
          "unit": "short",
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
          "expr": "ja4proxy_analytics_score_median",
          "legendFormat": "Median",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Shadow Score Median (Known-Good Traffic)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 10},
              {"color": "orange", "value": 20}
            ]
          },
          "unit": "short",
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
          "expr": "ja4proxy_analytics_shadow_score_median",
          "legendFormat": "Shadow Median",
          "instant": true
        }
      ]
    },
    {
      "id": 10,
      "title": "Risk Score Median — Trend",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "short",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
          "expr": "ja4proxy_analytics_score_median",
          "legendFormat": "Current median"
        },
        {
          "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
          "expr": "ja4proxy_analytics_shadow_score_median",
          "legendFormat": "Shadow (known-good)"
        }
      ]
    },
    {
      "id": 11,
      "title": "Analytics Signals Fired (rate/5m)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
          "expr": "rate(ja4proxy_analytics_signals_total{signal_type=\"campaign\"}[5m])",
          "legendFormat": "Campaign signals (+35)"
        },
        {
          "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
          "expr": "rate(ja4proxy_analytics_signals_total{signal_type=\"slowscan\"}[5m])",
          "legendFormat": "Slow-scan signals (+30)"
        }
      ]
    },
    {
      "id": 12,
      "title": "Analytics Stream Lag",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 30},
              {"color": "red", "value": 60}
            ]
          },
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "options": {
        "tooltip": {"mode": "single"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
          "expr": "ja4proxy_analytics_stream_lag_seconds",
          "legendFormat": "Stream lag"
        }
      ]
    },
    {
      "id": 13,
      "title": "Drift / Distribution Check Duration (p99)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
          "expr": "histogram_quantile(0.99, rate(ja4proxy_analytics_drift_check_duration_bucket[5m]))",
          "legendFormat": "Drift check p99"
        },
        {
          "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
          "expr": "histogram_quantile(0.99, rate(ja4proxy_analytics_distribution_check_duration_bucket[5m]))",
          "legendFormat": "Distribution check p99"
        }
      ]
    }
  ]
}

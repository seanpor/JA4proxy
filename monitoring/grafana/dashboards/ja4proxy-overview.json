{
  "id": null,
  "uid": "ja4proxy-overview",
  "title": "JA4 Proxy - Security Dashboard",
  "tags": ["ja4", "security", "proxy", "tls"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 4,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m"]
  },
  "panels": [
    {
      "id": 1,
      "title": "Connections/sec",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [{"color": "blue", "value": null}]},
          "unit": "reqps"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "targets": [
        {"expr": "sum(rate(ja4proxy_connections_total[30s]))", "legendFormat": ""}
      ]
    },
    {
      "id": 2,
      "title": "Allowed/sec",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [{"color": "green", "value": null}]},
          "unit": "reqps"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "targets": [
        {"expr": "sum(rate(ja4proxy_connections_total{action=\"allow\"}[30s]))", "legendFormat": ""}
      ]
    },
    {
      "id": 3,
      "title": "Blocked/sec",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [{"color": "red", "value": null}]},
          "unit": "reqps"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "targets": [
        {"expr": "sum(rate(ja4proxy_connections_total{action=~\"block|ban|tarpit|rate_limit\"}[30s]))", "legendFormat": ""}
      ]
    },
    {
      "id": 4,
      "title": "Block Rate %",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 30},
              {"color": "orange", "value": 50},
              {"color": "red", "value": 70}
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "targets": [
        {"expr": "sum(rate(ja4proxy_connections_total{action=~\"block|ban|tarpit|rate_limit\"}[30s])) / clamp_min(sum(rate(ja4proxy_connections_total[30s])), 1e-10) * 100", "legendFormat": ""}
      ]
    },
    {
      "id": 5,
      "title": "Active Connections",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 100}
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "targets": [
        {"expr": "ja4proxy_active_connections", "legendFormat": ""}
      ]
    },
    {
      "id": 6,
      "title": "Dial Setting",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 25},
              {"color": "orange", "value": 50},
              {"color": "red", "value": 75}
            ]
          },
          "unit": "short",
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "targets": [
        {"expr": "ja4proxy_dial_current", "legendFormat": "0=monitor 100=enforce"}
      ]
    },
    {
      "id": 10,
      "title": "Traffic Flow: Allowed vs Blocked",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 2,
            "stacking": {"mode": "normal"}
          },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Allowed"},
            "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Blocked"},
            "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]
          }
        ]
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {"expr": "sum(rate(ja4proxy_connections_total{action=\"allow\"}[30s]))", "legendFormat": "Allowed"},
        {"expr": "sum(rate(ja4proxy_connections_total{action=~\"block|ban|tarpit|rate_limit\"}[30s]))", "legendFormat": "Blocked"}
      ]
    },
    {
      "id": 11,
      "title": "Action Breakdown Over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 10, "lineWidth": 2},
          "unit": "reqps"
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {"expr": "sum by (action) (rate(ja4proxy_connections_total[30s]))", "legendFormat": "{{action}}"}
      ]
    },
    {
      "id": 20,
      "title": "Risk Score Percentiles",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 0, "lineWidth": 2},
          "unit": "short",
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(ja4proxy_risk_score_bucket[30s])) by (le))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum(rate(ja4proxy_risk_score_bucket[30s])) by (le))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum(rate(ja4proxy_risk_score_bucket[30s])) by (le))", "legendFormat": "p99"}
      ]
    },
    {
      "id": 21,
      "title": "Monitor Mode Counterfactuals",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 10, "lineWidth": 2},
          "unit": "reqps"
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean"]},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {"expr": "sum by (dial, action) (rate(ja4proxy_monitor_counterfactual_total[30s]))", "legendFormat": "dial={{dial}} → {{action}}"}
      ]
    },
    {
      "id": 30,
      "title": "Security Action Distribution (15m)",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 20},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}}
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]},
        "pieType": "donut",
        "tooltip": {"mode": "single"}
      },
      "targets": [
        {"expr": "sum by (action) (increase(ja4proxy_connections_total[15m]))", "legendFormat": "{{action}}"}
      ]
    },
    {
      "id": 31,
      "title": "TLS Version Distribution (15m)",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 20},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}}
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]},
        "pieType": "donut",
        "tooltip": {"mode": "single"}
      },
      "targets": [
        {"expr": "sum by (tls_version) (increase(ja4proxy_tls_version_total[15m]))", "legendFormat": "{{tls_version}}"}
      ]
    },
    {
      "id": 32,
      "title": "SNI Signals (15m)",
      "type": "table",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 20},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Value"},
            "properties": [
              {"id": "displayName", "value": "Count (15m)"},
              {"id": "thresholds", "value": {"steps": [{"color": "yellow", "value": null}, {"color": "red", "value": 100}]}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "signal"},
            "properties": [{"id": "displayName", "value": "Signal Type"}]
          }
        ]
      },
      "options": {
        "sortBy": [{"displayName": "Count (15m)", "desc": true}]
      },
      "transformations": [
        {"id": "sortBy", "options": {"sort": [{"field": "Value", "desc": true}]}}
      ],
      "targets": [
        {"expr": "sum by (signal) (increase(ja4proxy_sni_signal_total[15m]))", "legendFormat": "{{signal}}", "format": "table", "instant": true}
      ]
    },
    {
      "id": 40,
      "title": "TLS Versions Over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 28},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 10, "lineWidth": 2},
          "unit": "reqps"
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {"expr": "sum by (tls_version) (rate(ja4proxy_tls_version_total[30s]))", "legendFormat": "{{tls_version}}"}
      ]
    },
    {
      "id": 41,
      "title": "Weak Cipher Signals",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 28},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 10, "lineWidth": 2},
          "unit": "reqps"
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {"expr": "sum by (cipher_strength) (rate(ja4proxy_weak_cipher_total[30s]))", "legendFormat": "{{cipher_strength}}"}
      ]
    },
    {
      "id": 42,
      "title": "Risk Score Distribution",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 28},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 20, "lineWidth": 2},
          "unit": "short",
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(ja4proxy_risk_score_bucket[30s])) by (le))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum(rate(ja4proxy_risk_score_bucket[30s])) by (le))", "legendFormat": "p95"},
        {"expr": "rate(ja4proxy_static_allowlist_hits_total[30s])", "legendFormat": "allowlist hits/s"}
      ]
    },
    {
      "id": 50,
      "title": "Security Event Log (Proxy)",
      "type": "logs",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 36},
      "datasource": {"type": "loki", "uid": "ja4proxy-loki"},
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {"expr": "{service=\"proxy\"} |~ \"BLOCKED|ALLOWED|WHITELISTED|BLACKLISTED|TARPIT\"", "legendFormat": "", "refId": "A"}
      ]
    },
    {
      "id": 51,
      "title": "All Service Logs",
      "type": "logs",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 36},
      "datasource": {"type": "loki", "uid": "ja4proxy-loki"},
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {"expr": "{container=~\"ja4proxy.*\"}", "legendFormat": "", "refId": "A"}
      ]
    },
    {
      "id": 60,
      "title": "Counterfactuals by Dial Level (15m)",
      "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 44},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Value"},
            "properties": [
              {"id": "displayName", "value": "Connections"},
              {"id": "thresholds", "value": {"steps": [{"color": "yellow", "value": null}, {"color": "red", "value": 1000}]}}
            ]
          }
        ]
      },
      "options": {
        "sortBy": [{"displayName": "Connections", "desc": true}]
      },
      "transformations": [
        {"id": "sortBy", "options": {"sort": [{"field": "Value", "desc": true}]}}
      ],
      "targets": [
        {"expr": "sum by (dial, action) (increase(ja4proxy_monitor_counterfactual_total[15m]))", "legendFormat": "dial={{dial}} → {{action}}", "format": "table", "instant": true}
      ]
    },
    {
      "id": 61,
      "title": "Static Allowlist Hits Over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 44},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 20, "lineWidth": 2},
          "unit": "reqps",
          "color": {"fixedColor": "green", "mode": "fixed"}
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {"expr": "rate(ja4proxy_static_allowlist_hits_total[30s])", "legendFormat": "static allowlist hits/s"}
      ]
    }
  ],
  "annotations": {"list": []},
  "templating": {"list": []},
  "links": [],
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "liveNow": true
}
